# Deriv Options credentials for the persistent worker only.
# Never commit real values.
DERIV_APP_ID=
DERIV_TOKEN=
DERIV_ACCOUNT_ID=
DERIV_SYMBOL=1HZ25V
DERIV_CURRENCY=USD

# Deliberate real-money unlock. Leave blank for Demo.
ALLOW_REAL=

# Strategy / execution settings
STAKE=1
DURATION=1
DURATION_UNIT=t
EXECUTION_METHOD=direct
TP=2
SL=3
MAX_TRADES=10
BULL_ENABLED=true
BEAR_ENABLED=true
ONE_OPEN_CONTRACT=true
LOSS_STREAK=0
COOLDOWN_TICKS=0
MAX_SIGNAL_TO_SEND_MS=250
MAX_RECONNECT_ATTEMPTS=8

# Always-on worker control API
WORKER_PORT=8787
WORKER_CONTROL_KEY=replace-with-a-long-random-secret
WORKER_CORS_ORIGIN=*
AUTO_START=false
DATA_DIR=data
